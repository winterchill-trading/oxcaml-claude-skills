; Each file must fail to type-check with the error recorded in <name>.expected.
; `dune runtest` diffs the compiler's output against it; `dune promote` accepts a change.

(rule
 (deps unique_used_twice.ml)
 (action
  (with-outputs-to
   unique_used_twice.output
   (with-accepted-exit-codes
    2
    (run %{ocamlopt} -color never -i unique_used_twice.ml)))))

(rule
 (alias runtest)
 (action
  (diff unique_used_twice.expected unique_used_twice.output)))

