(rule
 (deps zero_alloc_boxed_float.ml)
 (action
  (with-outputs-to
   zero_alloc_boxed_float.output
   (system
    "%{ocamlopt} -color never -c zero_alloc_boxed_float.ml 2>&1 | sed -e 's/ (caml[A-Za-z0-9_]*)//'; true"))))

(rule
 (alias runtest)
 (action
  (diff zero_alloc_boxed_float.expected zero_alloc_boxed_float.output)))

