; Each file must fail to compile with the error recorded in <name>.expected.
; Type errors use `ocamlopt -i`. zero_alloc errors come from the backend, so those files
; are compiled with `-c` and the build-specific symbol names are stripped with sed.
; `dune runtest` diffs the output; `dune promote` accepts a change.

(rule
 (deps unboxed_in_option.ml)
 (action
  (with-outputs-to
   unboxed_in_option.output
   (with-accepted-exit-codes
    2
    (run %{ocamlopt} -color never -i unboxed_in_option.ml)))))

(rule
 (alias runtest)
 (action
  (diff unboxed_in_option.expected unboxed_in_option.output)))

