# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Compiling OxCaml performance examples for the oxcaml-performance skill"
maintainer: ["winterchill-trading"]
authors: ["winterchill-trading"]
license: "MIT"
homepage: "https://github.com/winterchill-trading/oxcaml-claude-skills"
bug-reports:
  "https://github.com/winterchill-trading/oxcaml-claude-skills/issues"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.17"}
  "core"
  "ppx_jane"
  "unboxed"
  "ocaml_intrinsics"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo:
  "git+https://github.com/winterchill-trading/oxcaml-claude-skills.git"
